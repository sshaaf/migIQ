# Agent Mesh Migration System - Environment Configuration
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Customize the values below for your environment
# 3. NEVER commit .env file to version control (it's in .gitignore)
#
# SECURITY WARNING:
# .env files may contain sensitive credentials. Keep them secure and never
# commit them to git or share publicly.

# ==============================================================================
# General Configuration
# ==============================================================================

# Session ID for migration tracking (auto-generated if not provided)
# SESSION_ID=mig-20260512-abc123

# Execution mode: interactive (pause on failures) or autonomous (auto-retry)
MODE=interactive

# Project path for migration
# PROJECT_PATH=./my-app

# Migration type: framework, dependency, data, api
# MIGRATION_TYPE=framework

# ==============================================================================
# Tracker Configuration
# ==============================================================================

# Tracker type: local (default), github, gitlab (planned), jira (planned)
TRACKER_TYPE=local

# ------------------------------------------------------------------------------
# Local Tracker
# ------------------------------------------------------------------------------
# File-based tracker using tasks.md (default, no external dependencies)

# Path to tasks.md file
TRACKER_LOCAL_TASKS_PATH=./tasks.md

# ------------------------------------------------------------------------------
# GitHub Tracker
# ------------------------------------------------------------------------------
# Sync migration stories to GitHub Projects v2

# GitHub Personal Access Token (required permissions: repo, project)
# Get token from: https://github.com/settings/tokens
# TRACKER_GITHUB_TOKEN=$GITHUB_TOKEN

# GitHub organization or username
# TRACKER_GITHUB_ORGANIZATION=my-org

# Optional: GitHub project number (visible in project URL: /projects/NUMBER)
# If not specified, a new project will be auto-created
# TRACKER_GITHUB_PROJECT_NUMBER=5

# Optional: Custom project name for auto-creation
# Default: "Migration Agent - {org} - {timestamp}"
# TRACKER_GITHUB_PROJECT_NAME=Java Migration Q2 2026

# Optional: Project description for auto-creation
# TRACKER_GITHUB_PROJECT_DESCRIPTION=Migration from Java 8 to Java 17

# Optional: Disable auto-creation (requires project_number if false)
# TRACKER_GITHUB_AUTO_CREATE=true

# Optional: Labels to apply to created issues (comma-separated)
# TRACKER_GITHUB_LABELS=migration,automated

# Optional: Default assignee for created issues
# TRACKER_GITHUB_DEFAULT_ASSIGNEE=migration-bot

# ------------------------------------------------------------------------------
# GitLab Tracker (Planned)
# ------------------------------------------------------------------------------
# Sync migration stories to GitLab Issues

# TRACKER_GITLAB_TOKEN=$GITLAB_TOKEN
# TRACKER_GITLAB_PROJECT_ID=12345
# TRACKER_GITLAB_URL=https://gitlab.com

# ------------------------------------------------------------------------------
# Jira Tracker (Planned)
# ------------------------------------------------------------------------------
# Sync migration stories to Jira

# TRACKER_JIRA_URL=https://your-domain.atlassian.net
# TRACKER_JIRA_EMAIL=your-email@example.com
# TRACKER_JIRA_API_TOKEN=$JIRA_API_TOKEN
# TRACKER_JIRA_PROJECT_KEY=PROJ

# ==============================================================================
# Agent Configuration
# ==============================================================================

# Project Tracker Agent
# (Add agent-specific configuration here as needed)

# Test Generator Agent
# (Add agent-specific configuration here as needed)

# Code Refactor Agent
# (Add agent-specific configuration here as needed)

# ==============================================================================
# Advanced Configuration
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Enable distributed tracing
# ENABLE_TRACING=false

# Trace backend URL
# TRACE_BACKEND_URL=http://localhost:9411
