# AI-Driven Code Migration System - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# CI/CD Platform Configuration
# ============================================================================

# CI Platform Type (gitlab or github)
CI_PLATFORM_TYPE=gitlab

# GitLab Configuration
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your-gitlab-personal-access-token
GITLAB_PROJECT_ID=your-project-id

# GitHub Configuration
GITHUB_URL=https://api.github.com
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPOSITORY=owner/repo

# ============================================================================
# Kanban Board Configuration
# ============================================================================

# Kanban Platform Type (jira, linear, or github-projects)
KANBAN_PLATFORM=jira

# Jira Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJECT

# Linear Configuration
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_API_KEY=your-linear-api-key
LINEAR_TEAM_ID=your-team-id

# GitHub Projects Configuration
GITHUB_PROJECTS_TOKEN=your-github-token
GITHUB_PROJECTS_NUMBER=1
GITHUB_PROJECTS_OWNER=your-org-or-username

# ============================================================================
# OpenCode Agent Configuration
# ============================================================================

# OpenCode Agent endpoint and credentials
OPENCODE_AGENT_API=http://localhost:8080
OPENCODE_AGENT_API_KEY=your-opencode-agent-api-key
OPENCODE_AGENT_CONFIG=./config/opencode-agent.yaml

# ============================================================================
# Build and Runtime Configuration
# ============================================================================

# Java Configuration
JAVA_HOME=/usr/lib/jvm/java-17-openjdk
MAVEN_HOME=/usr/share/maven
MAVEN_OPTS=-Xmx2g -XX:+UseG1GC

# Python Configuration
PYTHON_VERSION=3.11
VIRTUAL_ENV=.venv

# Node.js Configuration
NODE_VERSION=18
NPM_CONFIG_PREFIX=~/.npm-global

# ============================================================================
# Migration System Configuration
# ============================================================================

# Automation Settings
AUTOMATION_RATE_TARGET=80
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=1000

# Quality Thresholds
MIN_TEST_COVERAGE=80
MIN_BRANCH_COVERAGE=75
MAX_CYCLOMATIC_COMPLEXITY=10
MAX_PERFORMANCE_REGRESSION=5

# Parallel Execution
MAX_CONCURRENT_STORIES=3
AGENT_POOL_SIZE=5

# ============================================================================
# Monitoring and Observability
# ============================================================================

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

# Metrics and Tracing
ENABLE_DISTRIBUTED_TRACING=true
TRACE_SAMPLE_RATE=1.0
METRICS_ENDPOINT=http://localhost:9090/metrics

# KPI Dashboard
KPI_DASHBOARD_ENABLED=true
KPI_REFRESH_INTERVAL=300
KPI_RETENTION_DAYS=90

# ============================================================================
# Security Configuration
# ============================================================================

# Secrets Management
SECRETS_PROVIDER=env
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token

# API Security
API_RATE_LIMIT=100
API_RATE_WINDOW=60
ENABLE_AUDIT_LOG=true

# ============================================================================
# Notification Configuration
# ============================================================================

# Email Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
NOTIFICATION_EMAIL=team@example.com

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#migrations
SLACK_ENABLED=false

# ============================================================================
# Development and Testing
# ============================================================================

# Development Mode
DEV_MODE=false
SKIP_EXTERNAL_INTEGRATIONS=false
MOCK_OPENCODE_AGENT=false

# Test Configuration
TEST_DATA_PATH=./test-data
TEST_COVERAGE_REPORT_PATH=./coverage
BENCHMARK_DATA_PATH=./benchmarks/results

# ============================================================================
# Feature Flags
# ============================================================================

# Agent Features
ENABLE_AUTO_MERGE=false
ENABLE_PARALLEL_EXECUTION=true
ENABLE_FAILURE_RECOVERY=true
ENABLE_KPI_TRACKING=true

# Integration Features
ENABLE_GITLAB_INTEGRATION=true
ENABLE_GITHUB_INTEGRATION=false
ENABLE_JIRA_INTEGRATION=true
ENABLE_LINEAR_INTEGRATION=false

# ============================================================================
# Advanced Configuration
# ============================================================================

# Circuit Breaker Settings
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=300000

# Agent State Management
AGENT_STATE_PERSISTENCE=file
AGENT_STATE_DIR=./.claude/state
AGENT_CHECKPOINT_INTERVAL=60

# Performance Tuning
HTTP_TIMEOUT=30000
HTTP_MAX_CONNECTIONS=50
HTTP_CONNECTION_POOL_SIZE=10

# Database Configuration (if needed for metrics/state)
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=code_migration
DB_USER=migration_user
DB_PASSWORD=your-db-password
